# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# Frontend
VITE_API_URL=http://localhost:5000/api

# Backend
ASPNETCORE_URLS=http://localhost:5000
DatabaseProvider=Sqlite
ConnectionStrings__DefaultConnection=Data Source=agriculture.db

# JWT Settings
# Use environment variables in production. Replace the secret with a secure value.
Jwt__SecretKey=REPLACE_WITH_A_STRONG_SECRET
Jwt__Issuer=NgalaFarmsAPI
Jwt__Audience=NgalaFarmsClient
Jwt__ExpiryHours=8

# Database (Future PostgreSQL)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agriculture;Username=pguser;Password=secret
